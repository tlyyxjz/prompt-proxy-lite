# Upstream OpenAI-compatible backend (OpenAI / DeepSeek / OpenRouter / Groq / Together)
UPSTREAM_BASE_URL=https://api.deepseek.com/v1
UPSTREAM_API_KEY=sk-your-upstream-key-here

# Comma-separated list of client API keys your customers will use
CLIENT_API_KEYS=sk-client-one,sk-client-two,sk-client-three

# Path to prompts.yaml (relative to project root)
PROMPTS_FILE=prompts.yaml

# Server bind
HOST=0.0.0.0
PORT=8000
